{
  "name": "pickdealbum",
  "version": "0.1.0",
  "description": "Desktop photo album designer",
  "main": "out/main/index.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "better-sqlite3",
      "esbuild",
      "electron"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "selfcheck": "node electron/layout-engine.ts && node electron/project-store.ts && node electron/image-processor.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3 -w sharp",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "pdfkit": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.pickdealbum.app",
    "productName": "PickDeAlbum",
    "directories": { "output": "release" },
    "files": ["out/**/*", "node_modules/**/*"],
    "win": {
      "target": "nsis",
      "icon": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}